        <ui:VisualElement name="vehicles_mode_page" style="display: none; flex-grow: 1; min-height: 0; margin: 20px; padding: 16px; background-color: white; border-left-width: 1px; border-right-width: 1px; border-top-width: 3px; border-bottom-width: 1px; border-left-color: rgb(205, 214, 202); border-right-color: rgb(205, 214, 202); border-top-color: rgb(46, 139, 87); border-bottom-color: rgb(205, 214, 202); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
