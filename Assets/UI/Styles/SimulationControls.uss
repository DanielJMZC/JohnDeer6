.simulation-toolbar {
    height: 70px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgb(137, 183, 101);
}
.simulation-status {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(28, 61, 31);
    background-color: rgba(255, 255, 255, 0.65);
    padding: 7px 14px;
    margin-right: 16px;
    border-radius: 16px;
}
.simulation-button {
    min-width: 96px;
    height: 38px;
    flex-shrink: 0;
    margin: 0 0 0 8px;
    padding: 0 18px;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgb(218, 228, 212);
    background-color: rgb(248, 251, 246);
    color: rgb(35, 67, 38);
    font-size: 14px;
    -unity-font-style: bold;
}
.simulation-button:hover {
    background-color: rgb(230, 242, 222);
    border-color: rgb(68, 114, 63);
}
.simulation-button:active {
    background-color: rgb(210, 230, 198);
}
.simulation-primary {
    background-color: rgb(29, 86, 43);
    border-color: rgb(29, 86, 43);
    color: white;
}
.simulation-primary:hover { background-color: rgb(38, 107, 54); }
.simulation-primary:active { background-color: rgb(21, 66, 32); }
.simulation-button:focus {
    border-width: 2px;
    border-color: rgb(255, 224, 90);
}
.simulation-button:disabled {
    background-color: rgba(255, 255, 255, 0.25);
    border-color: rgba(42, 76, 35, 0.16);
    color: rgb(70, 98, 62);
    opacity: 0.65;
}
